# ==============================================================================
# ATELIER PLATFORM - MASTER ENVIRONMENT VARIABLES TEMPLATE (.env.example)
# ==============================================================================
# Copy this file to '.env' (or use .env.development / .env.production)
#
# IMPORTANT:
# - NEVER commit sensitive credentials or live secrets to version control.
# - The .env file is excluded by .gitignore.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. APPLICATION & SERVER RUNTIME
# ------------------------------------------------------------------------------
# Active Spring Profile: 'dev' (Development) | 'prod' (Production) | 'test' (Testing)
SPRING_PROFILES_ACTIVE=dev

# Application HTTP Port
SERVER_PORT=8080

# Servlet Context Path (Base path for all REST APIs)
SERVER_SERVLET_CONTEXT_PATH=/api/v1

# ------------------------------------------------------------------------------
# 2. DATABASE CONFIGURATION (PostgreSQL / TimescaleDB)
# ------------------------------------------------------------------------------
# Local Docker or Aiven Cloud PostgreSQL connection URL
# Dev format:  jdbc:postgresql://localhost:5432/atelier_db
# Prod format: jdbc:postgresql://<host>:<port>/atelier_db?sslmode=require
DATABASE_URL=jdbc:postgresql://localhost:5432/atelier_db
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=postgres

# HikariCP Connection Pool
DB_POOL_MAX_SIZE=10
DB_POOL_MIN_IDLE=2
DB_CONNECTION_TIMEOUT=30000

# ------------------------------------------------------------------------------
# 3. HIBERNATE / JPA SCHEMA MANAGEMENT
# ------------------------------------------------------------------------------
# Options: 'update' (Dev only) | 'validate' (Recommended for Prod) | 'none'
JPA_HIBERNATE_DDL_AUTO=update
JPA_SHOW_SQL=true
JPA_FORMAT_SQL=true

# ------------------------------------------------------------------------------
# 4. SECURITY & AUTHENTICATION (JWT & CORS)
# ------------------------------------------------------------------------------
# HMAC-SHA256 Secret Key (minimum 256 bits / 32 characters in base64 or hex)
# Tip: Generate with `openssl rand -hex 32` or `openssl rand -base64 32`
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970

# Token Expiration in Milliseconds (86400000 ms = 24 hours)
JWT_EXPIRATION_MS=86400000

# Refresh Token Expiration in Milliseconds (604800000 ms = 7 days)
JWT_REFRESH_EXPIRATION_MS=604800000

# Comma-separated list of allowed origins for CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:4200,http://localhost:5173,http://localhost:8080

# ------------------------------------------------------------------------------
# 5. SPRING AI - PREDICTIVE VEHICLE DIAGNOSTICS & TELEMETRY
# ------------------------------------------------------------------------------
# Provider Compatibility: Groq Cloud LPU, OpenAI, Ollama, NVIDIA NIM
# Groq free key: obtain at https://console.groq.com
SPRING_AI_OPENAI_API_KEY=gsk_your_groq_api_key_here
SPRING_AI_OPENAI_BASE_URL=https://api.groq.com/openai
SPRING_AI_OPENAI_MODEL=llama-3.3-70b-versatile
SPRING_AI_OPENAI_TEMPERATURE=0.1
SPRING_AI_OPENAI_MAX_TOKENS=2500

# ------------------------------------------------------------------------------
# 6. EXTERNAL GATEWAYS & INTEGRATIONS
# ------------------------------------------------------------------------------
# Stripe Payments (https://stripe.com)
STRIPE_API_KEY=sk_test_your_stripe_secret_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_stripe_webhook_secret_here

# Firebase Admin SDK & FCM Notifications (https://firebase.google.com)
FIREBASE_CREDENTIALS_PATH=firebase-service-account.json
FIREBASE_PROJECT_ID=atelier-platform

# Nubefact Electronic Invoicing - SUNAT Perú (https://www.nubefact.com)
NUBEFACT_API_URL=https://api.nubefact.com/api/v1/
NUBEFACT_TOKEN=your_nubefact_bearer_token_here

# Resend Email Gateway (https://resend.com)
RESEND_API_KEY=re_your_resend_api_key_here
RESEND_FROM_EMAIL=notifications@atelier.andeva.com

# ------------------------------------------------------------------------------
# 7. OBSERVABILITY & DOCUMENTATION
# ------------------------------------------------------------------------------
# Actuator Endpoints (health, info, metrics, prometheus)
MANAGEMENT_ENDPOINTS_WEB_EXPOSURE_INCLUDE=health,info,metrics,prometheus

# Swagger / OpenAPI Documentation UI (/api/v1/swagger-ui.html)
SWAGGER_ENABLED=true
