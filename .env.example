# ==============================================================================
# ATELIER PLATFORM - ENVIRONMENT VARIABLES TEMPLATE (.env.example)
# ==============================================================================
# Copy to .env.dev (local) or load into Render > Environment (production).
# This file is committed: ONLY placeholder values here, never real keys.
# Real secrets live in .env.dev / .env.prod (git-ignored) and in Render.
# Variables marked [PROD REQUIRED] make the prod profile fail fast if missing.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. RUNTIME
# ------------------------------------------------------------------------------
# 'dev' locally, 'prod' on Render (the Dockerfile already sets prod)
SPRING_PROFILES_ACTIVE=dev
# Render injects PORT automatically; only set it locally if 8080 is taken
# PORT=8080

# Public URL of the web front used in email links and Stripe return URLs:
#   {FRONTEND_BASE_URL}/auth/reset-password?token=...
#   {FRONTEND_BASE_URL}/auth/accept-invitation?token=...
#   {FRONTEND_BASE_URL}/app/billing
FRONTEND_BASE_URL=http://localhost:5173

# ------------------------------------------------------------------------------
# 2. DATABASE (PostgreSQL + TimescaleDB)
# ------------------------------------------------------------------------------
# Local: jdbc:postgresql://localhost:5432/atelier_db  (docker compose up -d)
# Aiven: jdbc:postgresql://<host>:<port>/defaultdb?sslmode=require
DATABASE_URL=jdbc:postgresql://localhost:5432/atelier_db
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=postgres
DB_POOL_MAX_SIZE=10
DB_POOL_MIN_IDLE=2
DB_CONNECTION_TIMEOUT=30000

# Hibernate schema management ('update' creates/alters tables automatically)
JPA_HIBERNATE_DDL_AUTO=update
JPA_SHOW_SQL=true
JPA_FORMAT_SQL=true

# ------------------------------------------------------------------------------
# 3. SECURITY
# ------------------------------------------------------------------------------
# [PROD REQUIRED] HMAC-SHA256 key, generate with: openssl rand -hex 32
# (the value below is a public development key: never use it in production)
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
# Access token lifetime in ms (3600000 = 1 hour)
JWT_EXPIRATION_MS=3600000

# Browser origins allowed by CORS (the web front). Mobile apps don't need CORS.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:4200,http://localhost:5173

# [PROD REQUIRED] Google Sign-In OAuth client IDs, comma-separated (Web,Android,iOS)
# Placeholder value = mock mode (any token signs in as a fake user: dev only!)
GOOGLE_CLIENT_ID=google_client_id_placeholder

# ------------------------------------------------------------------------------
# 4. AI DIAGNOSTICS (Groq, OpenAI-compatible) - https://console.groq.com
# ------------------------------------------------------------------------------
SPRING_AI_OPENAI_API_KEY=gsk_your_groq_api_key_here
SPRING_AI_OPENAI_BASE_URL=https://api.groq.com/openai/v1
SPRING_AI_OPENAI_MODEL=openai/gpt-oss-120b
SPRING_AI_OPENAI_TEMPERATURE=0.1
SPRING_AI_OPENAI_MAX_TOKENS=2500

# ------------------------------------------------------------------------------
# 5. STRIPE (SaaS subscriptions, test mode) - https://dashboard.stripe.com/test/apikeys
# ------------------------------------------------------------------------------
STRIPE_API_KEY=sk_test_your_stripe_secret_key_here
# [PROD REQUIRED] Signing secret of the endpoint https://<backend>/api/v1/billing/webhooks/stripe
STRIPE_WEBHOOK_SECRET=whsec_your_stripe_webhook_secret_here

# ------------------------------------------------------------------------------
# 6. FIREBASE (FCM push notifications only)
# ------------------------------------------------------------------------------
# Service account JSON. On Render upload it as a Secret File: /etc/secrets/firebase-service-account.json
FIREBASE_CREDENTIALS_PATH=firebase-service-account.json
FIREBASE_PROJECT_ID=your-firebase-project-id

# ------------------------------------------------------------------------------
# 7. SUPABASE STORAGE (images & scanned receipts, uploaded directly by the apps)
# ------------------------------------------------------------------------------
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_STORAGE_BUCKET=your-bucket-name

# ------------------------------------------------------------------------------
# 8. NUBEFACT (SUNAT electronic invoicing) - Nubefact > API (Integración)
# ------------------------------------------------------------------------------
# RUTA of the account (includes its unique id) and its TOKEN
NUBEFACT_API_URL=https://api.nubefact.com/api/v1/your-route-uuid
NUBEFACT_TOKEN=nubefact_token_placeholder

# ------------------------------------------------------------------------------
# 9. RESEND (transactional email, domain andeva.tech verified)
# ------------------------------------------------------------------------------
RESEND_API_KEY=re_your_resend_api_key_here
RESEND_FROM_EMAIL="Atelier <notificaciones@andeva.tech>"

# ------------------------------------------------------------------------------
# 10. GOOGLE MAPS PLATFORM (Places API New) - address normalization & coordinates
# ------------------------------------------------------------------------------
# Empty = mock mode (echoes the address with Lima coordinates)
GOOGLE_MAPS_API_KEY=

# ------------------------------------------------------------------------------
# 11. API DOCUMENTATION
# ------------------------------------------------------------------------------
# Swagger UI at /swagger-ui.html (set false to hide it in production)
SWAGGER_ENABLED=true
